# Copy this file to .env and adjust as needed.

# Port the API server listens on
PORT=4000

# Secret used to sign JWTs. CHANGE THIS before any real deployment.
JWT_SECRET=change-this-to-a-long-random-string

# How long an auth token stays valid
JWT_EXPIRES_IN=7d

# Postgres connection string. The default below matches the local Postgres
# started by `docker compose up` in this folder. For a hosted database
# (Render, Railway, Fly.io) paste the connection string that provider gives
# you instead.
DATABASE_URL=postgres://midfood:midfood@localhost:5432/midfood

# Set to "true" when DATABASE_URL points at a hosted Postgres that requires
# SSL (Render's managed Postgres does). Leave "false" for the local
# docker-compose database.
PGSSL=false

# Public address of this server, used to build the OAuth redirect URIs.
PUBLIC_URL=https://midfood.co.za

# "Continue with Google" / "Continue with Facebook". Leave blank and the
# buttons are not shown. Register the redirect URIs
#   <PUBLIC_URL>/api/auth/google/callback
#   <PUBLIC_URL>/api/auth/facebook/callback
# with Google Cloud Console and Meta for Developers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
